<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Kahuna.Aspire.Hosting</PackageId>
    <Description>.NET Aspire hosting integration for Kahuna: run a Kahuna node as a container resource in an Aspire AppHost.</Description>
    <PackageTags>aspire;hosting;kahuna;distributed lock;key-value;raft</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" Version="$(AspireVersion)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kahuna.Aspire.Hosting.Tests" />
  </ItemGroup>

</Project>
