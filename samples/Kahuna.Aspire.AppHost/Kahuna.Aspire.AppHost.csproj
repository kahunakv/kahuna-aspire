<Project Sdk="Aspire.AppHost.Sdk/13.6.5">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The dashboard and the orchestrator come from NuGet packages, so the sample runs with plain
         `dotnet run` and needs no Aspire CLI. ASPIRE010 only reports that choice. -->
    <AspireUseCliBundle>false</AspireUseCliBundle>
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
    <UserSecretsId>68f3ef1f-346f-4867-8fc7-e2b09c8402ca</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Kahuna.Aspire.Hosting\Kahuna.Aspire.Hosting.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="..\Kahuna.Aspire.ApiService\Kahuna.Aspire.ApiService.csproj" />
  </ItemGroup>

</Project>
