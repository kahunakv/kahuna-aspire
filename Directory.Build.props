<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>

    <AspireVersion>13.6.4</AspireVersion>
    <OpenTelemetryVersion>1.20.1</OpenTelemetryVersion>
    <MicrosoftExtensionsVersion>10.0.14</MicrosoftExtensionsVersion>

    <!-- The integrations need the DI registration and telemetry that Kahuna.Client gained in 1.15.1.
         With a Kahuna checkout next to this repository, the projects build against its source, so a
         change on both sides can be tested before either is released. Without one, they use the
         package. Pass -p:UseLocalKahuna=false to force the package. -->
    <KahunaRepoRoot Condition="'$(KahunaRepoRoot)' == ''">$(MSBuildThisFileDirectory)../kahuna/</KahunaRepoRoot>
    <UseLocalKahuna Condition="'$(UseLocalKahuna)' == '' and Exists('$(KahunaRepoRoot)Kahuna.Client/Kahuna.Client.csproj')">true</UseLocalKahuna>
    <KahunaPackageVersion>1.15.6</KahunaPackageVersion>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <VersionPrefix>0.1.0</VersionPrefix>
    <Authors>Andres Gutierrez</Authors>
    <Company>Kahuna KV</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/kahunakv/kahuna-aspire</PackageProjectUrl>
    <RepositoryUrl>https://github.com/kahunakv/kahuna-aspire</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

</Project>
